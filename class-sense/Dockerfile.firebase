FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN npm install -g firebase-tools@14.17.0

EXPOSE 8080 9099 4000

CMD ["firebase", "emulators:start", "--project", "demo-classsense", "--only", "firestore,auth", "--import=/workspace/.firebase-data", "--export-on-exit=/workspace/.firebase-data"]
